# Copy this file to .env and fill in your own values. Never commit .env.

# Backend API URL
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production: replace with your deployed backend URL, e.g.
# VITE_API_URL=https://your-backend.onrender.com/api

# Google Gemini API key (chatbot) - https://aistudio.google.com/apikey
VITE_CHATBOT_API_KEY=your_gemini_api_key_here

# Google Maps API key (Maps JavaScript API + Places API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# NASA API key (APOD) - https://api.nasa.gov (falls back to DEMO_KEY if empty)
VITE_NASA_API_KEY=your_nasa_api_key_here
